# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ---
# Leave empty to run with simulated payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# --- AI (optional; without it Purse uses its built-in rule reader) ---
# Any OpenAI-compatible endpoint:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Fully local, no key:  OPENAI_BASE_URL=http://localhost:11434/v1  AI_MODEL=llama3.1
# Or Anthropic:
# ANTHROPIC_API_KEY=
# AI_MODEL=

# --- Server ---
# PORT=8787
# PUBLIC_URL=https://your-app.onrender.com   # used for PayPal return URLs
# PURSE_AGENT_KEY=                            # optional bearer token for agent endpoints
